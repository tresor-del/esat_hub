# Local container ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL (the database is persisted in the db_data Docker volume)
POSTGRES_USER=esat_hub
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=esat_hub

# Backend security (replace these values outside local development)
ENV=dev
SECRET_KEY=local-development-secret-key-change-me-32
REFRESH_SECRET_KEY=local-development-refresh-key-change-me

# Application services
REDIS_URL=redis://redis:6379/0
SQLALCHEMY_DATABASE_URI=postgresql://esat_hub:local_dev_password@db:5432/esat_hub
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local SMTP is provided by Mailpit (web inbox: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=dev@example.com
EMAILS_FROM_NAME=ESAT-HUB Local
SMTP_TLS=false
SMTP_SSL=false

# Optional Firebase Admin service account file path inside the container
FIREBASE_CREDENTIALS_PATH=

# Frontend values are embedded during its image build
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# Optional integrations; leave empty for local development
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
ENCRYPTION_KEY=

# Optional initial super-admin account
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PROFIL_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SCHOOL_NAME=
SUPER_ADMIN_DOMAIN=
SUPER_ADMIN_LEVEL=
SUPER_ADMIN_YEAR=
SUPER_ADMIN_ROLE=
SUPER_ADMIN_STATUS=
SUPER_ADMIN_PHONE_NUMBER=
SUPER_ADMIN_BIRTHDAY=
SUPER_ADMIN_CARD_NUMBER=